{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "inventory-report/extensions/**/*.ts",
    "inventory-report/extensions/**/*.tsx",
    "tests/**/*.ts",
    "preview/**/*.ts",
    "preview/**/*.tsx",
    "playwright.config.ts"
  ]
}
